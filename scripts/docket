#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

DOCKER_COMMAND=()

die() {
    printf 'docket: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

init_docker() {
    if ((${#DOCKER_COMMAND[@]})); then
        return
    fi
    require_command docker
    if docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(docker)
    elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(
            sudo -n
            --preserve-env=DOCKET_SERVICE_ENV_FILE,DOCKET_BUILD_REVISION,DOCKET_PORT
            --preserve-env=DOCKET_DISCORD_PROJECTION_ENABLED,DOCKET_CREDENTIALS_DIR
            docker
        )
    else
        die "Docker is unavailable; grant access or run 'sudo -v' first"
    fi
}

docker_engine() {
    init_docker
    "${DOCKER_COMMAND[@]}" "$@"
}

compose() {
    init_docker
    "${DOCKER_COMMAND[@]}" compose "$@"
}

safe_test_environment() {
    mkdir -p "$ROOT/.runtime"
    export DOCKET_ENVIRONMENT=test
    export DOCKET_DATABASE_URL="sqlite+pysqlite:///$ROOT/.runtime/check.db"
    export DOCKET_AUTO_CREATE_SCHEMA=true
    export DOCKET_CALENDAR_READS_ENABLED=false
    export DOCKET_EXTERNAL_WRITES_ENABLED=false
    export DOCKET_GMAIL_INGESTION_ENABLED=false
    export DOCKET_GMAIL_WRITES_ENABLED=false
    export DOCKET_GMAIL_TRIAGE_SOURCE_ALLOWLIST='[]'
    export DOCKET_BACKUP_ENABLED=false
    export DOCKET_BACKUP_AGE_RECIPIENT=
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    export DOCKET_TO_HERMES_TOKEN_FILE="$ROOT/secrets/smoke/docket_to_hermes_token"
    export HERMES_TO_DOCKET_TOKEN_FILE="$ROOT/secrets/smoke/hermes_to_docket_token"
    export DOCKET_INTERACTION_SIGNING_KEY_FILE="$ROOT/secrets/smoke/interaction_signing_key"
    export DOCKET_ATTACHMENT_ENCRYPTION_KEY_FILE="$ROOT/secrets/smoke/attachment_encryption_key"
    export GOOGLE_OAUTH_CLIENT_FILE="$ROOT/secrets/smoke/google_oauth_client.json"
    export GOOGLE_OAUTH_TOKEN_FILE="$ROOT/secrets/smoke/google_oauth_token.json"
}

check() {
    require_command uv
    safe_test_environment
    uv sync --frozen
    uv run pytest
    uv run ruff check .
    uv run mypy
}

compose_smoke() (
    require_command uv
    init_docker

    local project=${DOCKET_SMOKE_PROJECT:-docket-smoke-${UID:-local}}
    local port=${DOCKET_SMOKE_PORT:-18080}
    export DOCKET_SERVICE_ENV_FILE="$ROOT/.env.example"
    export DOCKET_BUILD_REVISION
    DOCKET_BUILD_REVISION=$(git rev-parse HEAD 2>/dev/null || printf unknown)
    export DOCKET_PORT="$port"
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    export DOCKET_CREDENTIALS_DIR="$ROOT/secrets/smoke"
    export DOCKET_SMOKE_URL="http://127.0.0.1:$port"

    smoke_compose() {
        compose --project-name "$project" --env-file "$ROOT/.env.example" "$@"
    }
    cleanup() {
        local status=$?
        if ((status != 0)); then
            smoke_compose logs --no-color --tail 200 docket postgres >&2 || true
        fi
        smoke_compose down --volumes --remove-orphans >/dev/null 2>&1 || true
        return "$status"
    }
    trap cleanup EXIT INT TERM

    cleanup
    uv sync --frozen
    smoke_compose config --quiet
    smoke_compose up -d --build --wait --wait-timeout 180 postgres docket
    uv run python scripts/compose-mcp-smoke.py
    smoke_compose exec -T docket ./.venv/bin/python - <<'PY'
from sqlalchemy import create_engine, text
from sqlalchemy.exc import ProgrammingError

from docket.discord_ingress import ingress_database_url

engine = create_engine(ingress_database_url())
with engine.connect() as connection:
    assert connection.scalar(text("SELECT count(*) FROM persisted_semantic_options")) == 0
    try:
        connection.execute(text("UPDATE operator_utterances SET verbatim_text = verbatim_text"))
    except ProgrammingError:
        connection.rollback()
    else:
        raise AssertionError("restricted ingress role unexpectedly has UPDATE authority")
engine.dispose()
PY

    smoke_compose exec -T postgres createdb -U docket docket_readiness_rehearsal
    smoke_compose exec -T postgres createdb -U docket docket_readiness_restore
    smoke_compose exec -T postgres createdb -U docket docket_cutover_smoke
    smoke_compose run --rm --no-deps docket \
        ./.venv/bin/python -m docket.tracked_context_readiness synthetic-rehearsal \
        --rehearsal-url \
        postgresql+psycopg://docket:docket-smoke@postgres:5432/docket_readiness_rehearsal \
        --restore-url \
        postgresql+psycopg://docket:docket-smoke@postgres:5432/docket_readiness_restore \
        --backup /tmp/tracked-context-readiness.dump \
        --output /tmp/tracked-context-readiness-evidence.json
    smoke_compose run --rm --no-deps docket ./.venv/bin/python - <<'PY'
import json

import psycopg

from docket.tracked_context_readiness import (
    _sha256,
    _synthetic_payload,
    materialize_clean_cutover_database,
)

database_url = (
    "postgresql+psycopg://docket:docket-smoke@postgres:5432/docket_cutover_smoke"
)
provider_manifest = {
    "schema_version": 1,
    "document_ref": "ONT-DELTA-2026-08-29-TRACKED-CONTEXT",
    "generated_at": "2026-08-30T00:00:00+00:00",
    "provider_mutation_authorized": False,
    "reset_blockers": {
        "operations": [],
        "operation_items": [],
        "execution_attempts": [],
    },
    "accounts": [],
    "targets": [],
}
provider_manifest["manifest_sha256"] = _sha256(
    {
        key: value
        for key, value in provider_manifest.items()
        if key != "generated_at"
    }
)
result = materialize_clean_cutover_database(
    database_url=database_url,
    payload=_synthetic_payload(),
    provider_manifest=provider_manifest,
)
with psycopg.connect(database_url.replace("postgresql+psycopg://", "postgresql://")) as connection:
    assert connection.execute("SELECT count(*) FROM attachment_evidence_metadata").fetchone()[0] == 0
    assert connection.execute("SELECT count(*) FROM decisions").fetchone()[0] == 4
print(json.dumps(result, sort_keys=True))
PY
)

build_image() {
    init_docker
    local revision
    local short_revision
    local image_id
    revision=$(git rev-parse HEAD 2>/dev/null || printf unknown)
    short_revision=${revision:0:12}
    export DOCKET_BUILD_REVISION="$revision"
    compose config --quiet
    compose build docket
    image_id=$(docker_engine image inspect docket-docket:latest --format '{{.Id}}')
    [[ -n "$image_id" ]] || die "Docket image was built but could not be identified"
    docker_engine image tag "$image_id" "docket-docket:$short_revision"
    printf 'Built docket-docket:%s (%s)\n' "$short_revision" "$image_id"
}

env_value() {
    local key=$1
    awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' \
        "$ROOT/.env"
}

operational_counts() {
    compose exec -T postgres psql -U docket -d docket -Atc \
        "select
           (select count(*) from operations
             where status = 'running')
           || ' ' ||
           (select count(*) from outbox_events
             where status = 'delivering');"
}

assert_operationally_idle() {
    local counts
    local operations
    local outbox
    counts=$(operational_counts)
    read -r operations outbox <<<"$counts"
    [[ "$operations" == "0" ]] ||
        die "deployment blocked: $operations provider operation(s) are executing"
    [[ "$outbox" == "0" ]] ||
        die "deployment blocked: $outbox outbox delivery or deliveries are in flight"
}

wait_for_operational_idle() {
    local attempt
    local counts
    for attempt in {1..30}; do
        counts=$(operational_counts)
        if [[ "$counts" == "0 0" ]]; then
            return
        fi
        sleep 1
    done
    assert_operationally_idle
}

repository_name() {
    gh repo view --json nameWithOwner --jq .nameWithOwner
}

predeploy() {
    require_command git
    require_command gh
    [[ -f "$ROOT/.env" ]] || die "deployment requires $ROOT/.env"
    [[ "$(env_value DOCKET_ENVIRONMENT)" == "production" ]] ||
        die "deployment requires DOCKET_ENVIRONMENT=production"
    [[ -z "$(git status --porcelain)" ]] || die "deployment requires a clean worktree"
    [[ "$(git branch --show-current)" == "main" ]] || die "deployment requires the main branch"

    git fetch --quiet origin main
    local revision
    local upstream
    local repo
    local conclusion
    revision=$(git rev-parse HEAD)
    upstream=$(git rev-parse origin/main)
    [[ "$revision" == "$upstream" ]] || die "HEAD must exactly match origin/main"
    repo=$(repository_name)
    conclusion=$(
        gh run list \
            --repo "$repo" \
            --workflow CI \
            --commit "$revision" \
            --limit 1 \
            --json status,conclusion \
            --jq 'if length == 0 then "missing" else .[0].status + ":" + (.[0].conclusion // "") end'
    )
    [[ "$conclusion" == "completed:success" ]] ||
        die "CI for $revision is not green (state: $conclusion)"

    init_docker
    [[ -n "$(compose ps -q postgres)" ]] || die "the production PostgreSQL service is not running"
    printf 'Predeploy passed for %s at %s\n' "$repo" "$revision"
}

ensure_ingress_credential() {
    local configured_credentials_dir
    local credential_path
    configured_credentials_dir=$(env_value DOCKET_CREDENTIALS_DIR)
    case "$configured_credentials_dir" in
        /*) credential_path="$configured_credentials_dir/discord_ingress_db_password" ;;
        *) credential_path="$ROOT/${configured_credentials_dir#./}/discord_ingress_db_password" ;;
    esac
    if [[ -s "$credential_path" ]]; then
        return
    fi
    mkdir -p "$(dirname "$credential_path")"
    umask 077
    require_command openssl
    openssl rand -hex 32 >"$credential_path"
    chmod 600 "$credential_path"
    printf 'Created the restricted Discord ingress database credential.\n'
}

ensure_attachment_encryption_key() {
    local configured_credentials_dir
    local credential_path
    local retained_blob_count=0
    configured_credentials_dir=$(env_value DOCKET_CREDENTIALS_DIR)
    case "$configured_credentials_dir" in
        /*) credential_path="$configured_credentials_dir/attachment_encryption_key" ;;
        *) credential_path="$ROOT/${configured_credentials_dir#./}/attachment_encryption_key" ;;
    esac
    if [[ -s "$credential_path" ]]; then
        [[ "$(tr -d '\r\n' <"$credential_path")" =~ ^[0-9a-fA-F]{64}$ ]] ||
            die "attachment encryption key must contain exactly 32 hexadecimal bytes"
        return
    fi
    if [[ -n "$(compose ps -q postgres)" ]]; then
        if [[ "$(compose exec -T postgres psql -U docket -d docket -Atc \
            "select to_regclass('public.encrypted_attachment_blobs') is not null;")" == "t" ]]; then
            retained_blob_count=$(compose exec -T postgres psql -U docket -d docket -Atc \
                "select count(*) from encrypted_attachment_blobs;")
        fi
    fi
    [[ "$retained_blob_count" == "0" ]] ||
        die "attachment encryption key is missing while encrypted evidence exists"
    mkdir -p "$(dirname "$credential_path")"
    umask 077
    require_command openssl
    openssl rand -hex 32 >"$credential_path"
    chmod 600 "$credential_path"
    printf 'Created the attachment evidence encryption key; retain it with credential backups.\n'
}

request_hermes_drain() {
    local principal=${1:-scripts/docket deploy}
    compose exec -T --user hermes hermes python -c \
        "from gateway.drain_control import write_drain_request; write_drain_request(principal='$principal', suppress_notification=True)" \
        >/dev/null
}

clear_hermes_drain() {
    compose exec -T --user hermes hermes python -c \
        "from gateway.drain_control import clear_drain_request; clear_drain_request()" \
        >/dev/null 2>&1 || true
}

wait_for_hermes_drain() {
    local attempt
    local state
    for attempt in {1..180}; do
        if [[ -f "$ROOT/.runtime/hermes/gateway_state.json" ]]; then
            state=$(uv run python -c \
                "import json; d=json.load(open('.runtime/hermes/gateway_state.json')); print(f\"{d.get('gateway_state')} {d.get('active_agents', -1)}\")")
            if [[ "$state" == "draining 0" ]]; then
                return
            fi
        fi
        sleep 1
    done
    die "Hermes did not reach draining with zero active turns within 180 seconds"
}

wait_for_discord_ingress() {
    local service=${1:-discord-ingress}
    local attempt
    local container
    local health
    container=$(compose ps -q "$service")
    [[ -n "$container" ]] || die "$service is not running"
    for attempt in {1..120}; do
        health=$(docker_engine inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")
        [[ "$health" == "healthy" ]] && return
        [[ "$health" == "unhealthy" || "$health" == "exited" ]] && break
        sleep 1
    done
    die "$service did not become healthy"
}

database_continuity() {
    if [[ -n "$(compose ps -q docket)" ]]; then
        compose exec -T docket ./.venv/bin/docket-continuity "$@"
        return
    fi
    compose run --rm --no-deps docket ./.venv/bin/docket-continuity "$@"
}

request_database_drain() {
    local principal=${1:-scripts/docket deploy}
    local output
    output=$(database_continuity request --requested-by "$principal")
    uv run python -c "import json,sys; print(json.load(sys.stdin)['ref'])" <<<"$output"
}

wait_for_database_drain() {
    local drain_ref=$1
    local attempt
    local output
    local status_line
    for attempt in {1..180}; do
        output=$(database_continuity status "$drain_ref")
        status_line=$(uv run python -c \
            "import json,sys; d=json.load(sys.stdin); print(f\"{int(d['drained'])} {int(d['timed_out'])}\")" \
            <<<"$output")
        [[ "$status_line" == "1 0" ]] && return
        [[ "$status_line" == "0 1" ]] && {
            printf '%s\n' "$output" >&2
            return 1
        }
        sleep 1
    done
    return 1
}

backup_database() {
    local revision
    local timestamp
    local destination
    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    destination="$ROOT/backups/docket-$timestamp-$revision.dump"
    if [[ ! -d "$ROOT/backups" ]]; then
        mkdir -p "$ROOT/backups"
    fi
    if [[ ! -w "$ROOT/backups" ]]; then
        command -v sudo >/dev/null 2>&1 ||
            die "backup directory is not writable and sudo is unavailable: $ROOT/backups"
        sudo -n chown -- "$(id -u):$(id -g)" "$ROOT/backups" ||
            die "could not assign the backup directory to the invoking operator"
        sudo -n chmod 700 "$ROOT/backups" ||
            die "could not restrict backup directory permissions"
    fi
    umask 077
    compose exec -T postgres pg_dump -U docket -d docket --format=custom >"$destination"
    [[ -s "$destination" ]] || die "database backup is empty: $destination"
    chmod 600 "$destination" ||
        die "could not restrict database backup permissions: $destination"
    printf '%s\n' "$destination"
}

wait_for_docket() {
    local attempt
    for attempt in {1..60}; do
        if compose exec -T docket python -c \
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" \
            >/dev/null 2>&1; then
            return
        fi
        sleep 2
    done
    die "Docket did not become healthy within 120 seconds"
}

wait_for_hermes() {
    local first_line=$1
    local attempt
    local expected_tool_count
    local segment
    expected_tool_count=$(
        uv run python -c \
            "import runpy; from pathlib import Path; m=runpy.run_path('scripts/sync_hermes_docket_config.py'); print(len(m['_tool_block'](Path('hermes/config.example.yaml').read_text()).splitlines()))"
    )
    for attempt in {1..60}; do
        if [[ -f "$ROOT/.runtime/hermes/logs/agent.log" ]]; then
            segment=$(tail -n +"$first_line" "$ROOT/.runtime/hermes/logs/agent.log")
            if rg -q '\[Discord\] Connected as ' <<<"$segment" &&
                rg -q "registered ${expected_tool_count} tool\\(s\\)" <<<"$segment" &&
                rg -q 'Gateway running with 1 platform\(s\)' <<<"$segment"; then
                return
            fi
        fi
        sleep 2
    done
    die "Hermes did not connect to Discord with the expected MCP registry within 120 seconds"
}

postdeploy() {
    local expected_plugin_version
    local plugin_line
    wait_for_docket
    wait_for_discord_ingress
    compose exec -T docket ./.venv/bin/alembic current | rg -q '\(head\)' ||
        die "Docket database is not at the Alembic head"
    expected_plugin_version=$(
        awk '$1 == "version:" { print $2; exit }' \
            "$ROOT/hermes/plugin/docket_discord/plugin.yaml"
    )
    plugin_line=$(compose exec -T hermes hermes plugins list --plain --no-bundled |
        rg 'docket-discord')
    rg -q "enabled[[:space:]]+user[[:space:]]+$expected_plugin_version[[:space:]]+docket-discord" \
        <<<"$plugin_line" ||
        die "Hermes did not load docket-discord $expected_plugin_version"
    compose exec -T hermes python -c \
        "import socket; s=socket.create_connection(('127.0.0.1',8787),3); s.close()" ||
        die "Hermes projection listener is unreachable"
    assert_operationally_idle
}

deploy() {
    predeploy
    local backup
    local drain_ref=""
    local old_container
    local old_image
    local rollback_tag
    local log_first_line=1
    local revision
    local timestamp
    local cleanup_on_failure=0

    deploy_failure_cleanup() {
        if ((cleanup_on_failure)); then
            if [[ -n "$drain_ref" ]]; then
                database_continuity abort "$drain_ref" >/dev/null 2>&1 || true
            fi
            clear_hermes_drain
            printf 'Deployment failed; released the drain barrier without killing active work.\n' >&2
        fi
    }

    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    ensure_ingress_credential
    ensure_attachment_encryption_key
    old_container=$(compose ps -q docket)
    if [[ -n "$old_container" ]]; then
        old_image=$(docker_engine inspect --format '{{.Image}}' "$old_container")
        rollback_tag="docket-docket:rollback-$timestamp"
        docker_engine image tag "$old_image" "$rollback_tag"
        printf 'Previous image retained as %s\n' "$rollback_tag"
    else
        rollback_tag="none"
    fi
    "$ROOT/scripts/prepare-hermes-home.sh"
    if [[ -f "$ROOT/.runtime/hermes/logs/agent.log" ]]; then
        log_first_line=$(( $(wc -l <"$ROOT/.runtime/hermes/logs/agent.log") + 1 ))
    fi

    build_image
    if [[ -z "$(compose ps -q discord-ingress)" ]]; then
        backup=$(backup_database)
        printf 'Pre-bootstrap database backup created: %s\n' "$backup"
        compose run --rm --no-deps docket sh -c \
            './.venv/bin/alembic upgrade head && ./.venv/bin/docket-provision-ingress-role'
        compose up -d --no-build --wait --wait-timeout 120 discord-ingress
        printf 'Started deployment-stable Discord ingress.\n'
    fi
    wait_for_discord_ingress
    drain_ref=$(request_database_drain)
    cleanup_on_failure=1
    trap deploy_failure_cleanup EXIT
    printf 'Deployment drain requested: %s\n' "$drain_ref"
    request_hermes_drain
    # Confirm the durable execution barrier before waiting for Hermes. New
    # Discord ingress is captured and deferred while the gateway drains.
    if ! wait_for_database_drain "$drain_ref" || ! wait_for_hermes_drain; then
        database_continuity abort "$drain_ref" >/dev/null || true
        clear_hermes_drain
        die "deployment drain timed out; active work was not interrupted"
    fi
    wait_for_operational_idle
    backup=$(backup_database)
    printf 'Drained database backup created: %s\n' "$backup"
    compose run --rm --no-deps docket sh -c \
        './.venv/bin/alembic upgrade head && ./.venv/bin/docket-provision-ingress-role'
    compose up -d --no-build --force-recreate docket hermes
    wait_for_hermes "$log_first_line"
    clear_hermes_drain
    database_continuity release "$drain_ref" >/dev/null
    gmail_triage_setup
    postdeploy
    cleanup_on_failure=0
    trap - EXIT
    printf 'Deployed %s\nBackup: %s\nPrevious image: %s\n' \
        "$revision" "$backup" "$rollback_tag"
}

deploy_ingress() {
    predeploy
    local drain_ref=""
    local cleanup_on_failure=0
    local options_quiesced=0

    ingress_failure_cleanup() {
        if ((cleanup_on_failure)); then
            if ((options_quiesced)); then
                database_continuity regenerate-ingress-options >/dev/null 2>&1 || true
            fi
            if [[ -n "$drain_ref" ]]; then
                database_continuity abort "$drain_ref" >/dev/null 2>&1 || true
            fi
            clear_hermes_drain
            printf 'Ingress deployment failed; the handoff writer was left running if started.\n' >&2
        fi
    }

    ensure_ingress_credential
    ensure_attachment_encryption_key
    [[ -n "$(compose ps -q discord-ingress)" ]] ||
        die "ingress-only deployment requires the stable ingress to be running"
    compose exec -T docket ./.venv/bin/alembic current | rg -q '\(head\)' ||
        die "ingress-only deployment requires the database at the current Alembic head"
    build_image
    drain_ref=$(request_database_drain)
    cleanup_on_failure=1
    trap ingress_failure_cleanup EXIT
    request_hermes_drain "scripts/docket deploy-ingress"
    if ! wait_for_database_drain "$drain_ref" || ! wait_for_hermes_drain; then
        die "ingress deployment drain timed out; active work was not interrupted"
    fi
    wait_for_operational_idle
    database_continuity quiesce-ingress-options >/dev/null
    options_quiesced=1

    compose --profile ingress-handoff up -d --no-build --force-recreate \
        discord-ingress-handoff
    wait_for_discord_ingress discord-ingress-handoff
    compose up -d --no-build --force-recreate discord-ingress
    wait_for_discord_ingress discord-ingress
    compose --profile ingress-handoff stop discord-ingress-handoff >/dev/null
    compose --profile ingress-handoff rm -f discord-ingress-handoff >/dev/null

    database_continuity regenerate-ingress-options >/dev/null
    options_quiesced=0
    clear_hermes_drain
    database_continuity release "$drain_ref" >/dev/null
    postdeploy
    cleanup_on_failure=0
    trap - EXIT
    printf 'Deployed the Discord ingress through a quiesced rolling handoff.\n'
}

status() {
    printf 'Source: %s\n' "$(git log -1 --oneline)"
    init_docker
    compose ps
    if [[ -n "$(compose ps -q postgres)" ]]; then
        local counts
        counts=$(operational_counts)
        printf 'Executing operations / delivering outbox: %s\n' "$counts"
    fi
}

encrypted_backup() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.backup_cli backup
}

gmail_triage_setup() {
    init_docker
    DOCKET_HERMES_HOME="$ROOT/.runtime/hermes" \
        "$ROOT/scripts/setup-hermes-triage.sh"
}

hermes_oauth_setup() {
    DOCKET_HERMES_HOME="$ROOT/.runtime/hermes" \
        "$ROOT/scripts/setup-hermes-oauth.sh" "${1:---main}"
}

gmail_triage_job_id() {
    local job_name="Docket Gmail triage"
    local listing
    local -a job_ids=()

    listing=$(compose exec -T hermes env NO_COLOR=1 hermes cron list --all)
    mapfile -t job_ids < <(
        awk -v wanted="$job_name" '
            /^  [[:alnum:]]+/ {
                candidate = $1
                next
            }
            /^[[:space:]]+Name:/ {
                name = $0
                sub(/^[[:space:]]+Name:[[:space:]]*/, "", name)
                if (name == wanted) {
                    print candidate
                }
            }
        ' <<<"$listing"
    )
    ((${#job_ids[@]} == 1)) ||
        die "expected exactly one '$job_name' cron job; found ${#job_ids[@]}"
    printf '%s\n' "${job_ids[0]}"
}

gmail_triage_control() {
    local command=$1
    local job_id
    local listing

    init_docker
    job_id=$(gmail_triage_job_id)
    case "$command" in
        status)
            compose exec -T hermes env NO_COLOR=1 hermes cron list --all
            compose exec -T hermes env NO_COLOR=1 hermes cron runs --limit 10 "$job_id"
            compose exec -T hermes env NO_COLOR=1 hermes cron status
            ;;
        pause|resume)
            compose exec -T hermes hermes cron "$command" "$job_id"
            ;;
        run)
            listing=$(compose exec -T hermes env NO_COLOR=1 hermes cron list --all)
            awk -v job_id="$job_id" '
                $1 == job_id && index($0, "[paused]") {
                    found = 1
                }
                END {
                    exit(found ? 0 : 1)
                }
            ' <<<"$listing" ||
                die "one-shot triage requires the recurring job to be paused"
            compose exec -T hermes env \
                PATH=/opt/hermes/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                /opt/data/scripts/docket-gmail-triage.sh
            ;;
        *)
            die "unsupported Gmail triage control: $command"
            ;;
    esac
}

gmail() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.gmail_cli "$@"
}

tracked_context_readiness() (
    init_docker
    local live_container
    local live_image
    local live_revision
    local deployment_revision
    local timestamp
    local output_dir
    local snapshot
    local network
    local postgres_container
    local password
    local database_url

    live_container=$(compose ps -q docket)
    [[ -n "$live_container" ]] || die "tracked-context rehearsal requires live Docket"
    live_image=$(docker_engine inspect --format '{{.Image}}' "$live_container")
    live_revision=$(docker_engine inspect \
        --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
        "$live_container")
    [[ -n "$live_image" && -n "$live_revision" ]] ||
        die "could not resolve the matching pre-reset application image"
    deployment_revision=$(git rev-parse HEAD)

    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    output_dir="$ROOT/backups/tracked-context-readiness-$timestamp"
    mkdir -p "$output_dir"
    chmod 700 "$output_dir"
    umask 077
    snapshot="$output_dir/pre-reset-source.dump"
    compose exec -T postgres pg_dump -U docket -d docket --format=custom >"$snapshot"
    [[ -s "$snapshot" ]] || die "read-only production snapshot is empty"
    chmod 600 "$snapshot"

    build_image
    network="docket-readiness-${UID:-local}-$$"
    postgres_container="$network-postgres"
    password="docket-readiness-$$"
    cleanup_readiness() {
        local status=$?
        docker_engine rm -f "$postgres_container" >/dev/null 2>&1 || true
        docker_engine network rm "$network" >/dev/null 2>&1 || true
        return "$status"
    }
    trap cleanup_readiness EXIT INT TERM
    docker_engine network create "$network" >/dev/null
    docker_engine run -d --name "$postgres_container" --network "$network" \
        -e POSTGRES_DB=docket_source \
        -e POSTGRES_USER=docket \
        -e "POSTGRES_PASSWORD=$password" \
        postgres:16.9-bookworm >/dev/null
    for _attempt in {1..60}; do
        if docker_engine exec "$postgres_container" \
            pg_isready -U docket -d docket_source >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    docker_engine exec "$postgres_container" \
        pg_isready -U docket -d docket_source >/dev/null ||
        die "isolated readiness PostgreSQL did not become ready"
    docker_engine cp "$snapshot" "$postgres_container:/tmp/pre-reset-source.dump"
    docker_engine exec "$postgres_container" pg_restore \
        -U docket -d docket_source --exit-on-error --no-owner --no-privileges \
        /tmp/pre-reset-source.dump
    docker_engine exec "$postgres_container" createdb \
        -U docket docket_readiness_rehearsal
    docker_engine exec "$postgres_container" createdb \
        -U docket docket_readiness_restore

    database_url="postgresql+psycopg://docket:$password@$postgres_container:5432"
    docker_engine run --rm --network "$network" \
        -e "DOCKET_DATABASE_URL=$database_url/docket_source" \
        -e "DATABASE_TARGET=postgresql://docket:$password@$postgres_container:5432/docket_source" \
        "$live_image" sh -ec \
        './.venv/bin/alembic current | grep -F "(head)"
         psql "$DATABASE_TARGET" -v ON_ERROR_STOP=1 -Atc \
           "SELECT count(*) FROM operator_utterances;
            SELECT count(*) FROM decisions;
            SELECT count(*) FROM operations;"' \
        >"$output_dir/matching-image-restore.txt"
    chmod 600 "$output_dir/matching-image-restore.txt"

    docker_engine run --rm --user "$(id -u):$(id -g)" --network "$network" \
        -v "$output_dir:/output" \
        -v "$ROOT/deltas/docket-ontology-readiness-status-08-27-2026.yaml:/input/ontology-readiness.yaml:ro" \
        docket-docket:latest ./.venv/bin/python -m docket.tracked_context_readiness \
        export-governance --database-url "$database_url/docket_source" \
        --seed-file /input/ontology-readiness.yaml \
        --output /output/governance-closure.json
    docker_engine run --rm --user "$(id -u):$(id -g)" --network "$network" \
        -v "$output_dir:/output" \
        docket-docket:latest ./.venv/bin/python -m docket.tracked_context_readiness \
        provider-inventory --database-url "$database_url/docket_source" \
        --output /output/provider-disposition-manifest.json
    docker_engine run --rm --user "$(id -u):$(id -g)" --network "$network" \
        -v "$output_dir:/output" \
        docket-docket:latest ./.venv/bin/python -m docket.tracked_context_readiness \
        rehearse --closure /output/governance-closure.json \
        --provider-manifest /output/provider-disposition-manifest.json \
        --rehearsal-url "$database_url/docket_readiness_rehearsal" \
        --restore-url "$database_url/docket_readiness_restore" \
        --backup /output/clean-rehearsal.dump \
        --output /output/clean-rehearsal-evidence.json

    sha256sum "$snapshot" >"$output_dir/pre-reset-source.dump.sha256"
    chmod 600 "$output_dir/pre-reset-source.dump.sha256"
    docker_engine run --rm --user "$(id -u):$(id -g)" \
        -v "$output_dir:/output" \
        docket-docket:latest ./.venv/bin/python -m docket.production_cutover \
        build-manifest --backup /output/pre-reset-source.dump \
        --backup-ref pre-reset-source.dump \
        --deployment-revision "$deployment_revision" \
        --matching-application-image "$live_image" \
        --matching-application-revision "$live_revision" \
        --matching-restore-evidence /output/matching-image-restore.txt \
        --closure /output/governance-closure.json \
        --provider-manifest /output/provider-disposition-manifest.json \
        --rehearsal-evidence /output/clean-rehearsal-evidence.json \
        --output /output/production-reset-manifest.json
    docker_engine run --rm --user "$(id -u):$(id -g)" \
        -v "$output_dir:/output:ro" \
        docket-docket:latest ./.venv/bin/python -m docket.production_cutover \
        authorization-text --manifest /output/production-reset-manifest.json \
        >"$output_dir/production-reset-authorization.txt"
    chmod 600 "$output_dir/production-reset-authorization.txt"
    printf 'Tracked-context readiness rehearsal passed.\n'
    printf 'Private evidence: %s\n' "$output_dir"
    printf 'Matching pre-reset image: %s (%s)\n' "$live_image" "$live_revision"
    printf 'Exact production reset authorization (not yet granted):\n'
    cat "$output_dir/production-reset-authorization.txt"
)

json_field() {
    local path=$1
    local field=$2
    uv run python -c \
        'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))[sys.argv[2]])' \
        "$path" "$field"
}

database_url_for_name() {
    local database_url=$1
    local database_name=$2
    uv run python -c \
        'import sys; from urllib.parse import urlsplit,urlunsplit; p=urlsplit(sys.argv[1]); print(urlunsplit((p.scheme,p.netloc,"/"+sys.argv[2],p.query,p.fragment)))' \
        "$database_url" "$database_name"
}

database_exists() {
    local database_name=$1
    compose exec -T postgres psql -U docket -d postgres -Atc \
        "SELECT count(*) FROM pg_database WHERE datname = '$database_name';"
}

drop_cutover_database() {
    local database_name=$1
    [[ "$database_name" =~ ^docket_(cutover|pre_reset|failed_clean)_[0-9a-f]{12}_[0-9]{8}t[0-9]{6}z$ ]] ||
        die "refusing to drop database outside the cutover namespace: $database_name"
    compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$database_name' AND pid <> pg_backend_pid();" \
        >/dev/null
    compose exec -T postgres dropdb -U docket --if-exists "$database_name"
}

production_reset() (
    local evidence_dir_input=${1:-}
    local execution_flag=${2:-}
    [[ -n "$evidence_dir_input" && "$execution_flag" == "--execute" ]] ||
        die "usage: scripts/docket production-reset EVIDENCE_DIR --execute"
    require_command realpath
    local evidence_dir
    evidence_dir=$(realpath "$evidence_dir_input")
    case "$evidence_dir/" in
        "$ROOT/backups/"*) ;;
        *) die "production reset evidence must be inside $ROOT/backups" ;;
    esac

    local manifest="$evidence_dir/production-reset-manifest.json"
    local backup="$evidence_dir/pre-reset-source.dump"
    local closure="$evidence_dir/governance-closure.json"
    local provider_manifest="$evidence_dir/provider-disposition-manifest.json"
    local rehearsal="$evidence_dir/clean-rehearsal-evidence.json"
    local authority_evidence="$evidence_dir/production-reset-authority.json"
    local final_closure="$evidence_dir/final-governance-closure.json"
    local closure_extension="$evidence_dir/final-governance-extension.json"
    local materialization="$evidence_dir/clean-materialization.json"
    local clean_authority="$evidence_dir/clean-authority-verification.json"
    local completion_evidence="$evidence_dir/production-reset-completion.json"
    local required_path
    for required_path in \
        "$manifest" "$backup" "$closure" "$provider_manifest" "$rehearsal"; do
        [[ -s "$required_path" ]] || die "required reset artifact is missing: $required_path"
    done

    predeploy
    ensure_ingress_credential
    ensure_attachment_encryption_key

    local revision
    local short_revision
    local timestamp
    local database_url
    local clean_database
    local clean_database_url
    local quarantine_database
    local failed_clean_database
    local old_image
    local rollback_tag
    local drain_ref=""
    local log_first_line=1
    local authority_decision_ref
    local authority_audit_ref
    local clean_created=0
    local old_renamed=0
    local reset_complete=0

    revision=$(git rev-parse HEAD)
    short_revision=${revision:0:12}
    timestamp=$(date -u +%Y%m%dt%H%M%Sz)
    database_url=$(env_value DOCKET_DATABASE_URL)
    [[ -n "$database_url" ]] || die "DOCKET_DATABASE_URL is not configured"
    clean_database="docket_cutover_${short_revision}_${timestamp}"
    quarantine_database="docket_pre_reset_${short_revision}_${timestamp}"
    failed_clean_database="docket_failed_clean_${short_revision}_${timestamp}"
    clean_database_url=$(database_url_for_name "$database_url" "$clean_database")
    old_image=$(json_field "$manifest" matching_application_image)
    docker_engine image inspect "$old_image" >/dev/null ||
        die "matching pre-reset image is unavailable: $old_image"
    rollback_tag="docket-docket:pre-reset-$timestamp"
    docker_engine image tag "$old_image" "$rollback_tag"
    printf 'Matching pre-reset image retained as %s.\n' "$rollback_tag"

    reset_failure_cleanup() {
        local status=$?
        trap - EXIT INT TERM
        if ((${reset_complete:-0})); then
            return "$status"
        fi
        set +e
        compose stop -t 30 discord-ingress hermes docket >/dev/null 2>&1
        if ((old_renamed)); then
            if [[ "$(database_exists docket)" == "1" ]]; then
                compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
                    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'docket' AND pid <> pg_backend_pid();" \
                    >/dev/null
                compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
                    "ALTER DATABASE docket RENAME TO $failed_clean_database;" >/dev/null
            fi
            if [[ "$(database_exists "$quarantine_database")" == "1" ]]; then
                compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
                    "ALTER DATABASE $quarantine_database RENAME TO docket;" >/dev/null
            fi
            if [[ "$(database_exists "$failed_clean_database")" == "1" ]]; then
                drop_cutover_database "$failed_clean_database" >/dev/null
            fi
        elif ((clean_created)) && [[ "$(database_exists "$clean_database")" == "1" ]]; then
            drop_cutover_database "$clean_database" >/dev/null
        fi
        docker_engine image tag "$old_image" docket-docket:latest >/dev/null 2>&1
        compose up -d --no-build --force-recreate docket hermes discord-ingress >/dev/null 2>&1
        if [[ -n "$drain_ref" ]]; then
            database_continuity abort "$drain_ref" >/dev/null 2>&1
        fi
        clear_hermes_drain
        if [[ "$(database_exists docket)" == "1" ]]; then
            printf 'Production reset failed; the pre-reset database and image were restored.\n' >&2
        else
            printf 'Production reset failed and automatic database restoration is incomplete; services remain unsafe to use.\n' >&2
        fi
        return "$status"
    }
    trap reset_failure_cleanup EXIT INT TERM

    build_image
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        -e "RESET_DEPLOYMENT_REVISION=$revision" \
        docket sh -ec \
        './.venv/bin/python -m docket.production_cutover verify-execution \
           --manifest /reset/production-reset-manifest.json \
           --backup /reset/pre-reset-source.dump \
           --closure /reset/governance-closure.json \
           --provider-manifest /reset/provider-disposition-manifest.json \
           --rehearsal-evidence /reset/clean-rehearsal-evidence.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --operator-discord-user-id "$DOCKET_OPERATOR_DISCORD_USER_ID" \
           --deployment-revision "$RESET_DEPLOYMENT_REVISION" \
           --output /reset/production-reset-authority.json'

    if [[ -f "$ROOT/.runtime/hermes/logs/agent.log" ]]; then
        log_first_line=$(( $(wc -l <"$ROOT/.runtime/hermes/logs/agent.log") + 1 ))
    fi
    drain_ref=$(request_database_drain "scripts/docket production-reset")
    printf 'Production reset drain requested: %s\n' "$drain_ref"
    request_hermes_drain "scripts/docket production-reset"
    if ! wait_for_database_drain "$drain_ref" || ! wait_for_hermes_drain; then
        die "production reset drain timed out; no database replacement occurred"
    fi
    wait_for_operational_idle

    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        -e "RESET_DEPLOYMENT_REVISION=$revision" \
        docket sh -ec \
        './.venv/bin/python -m docket.production_cutover verify-execution \
           --manifest /reset/production-reset-manifest.json \
           --backup /reset/pre-reset-source.dump \
           --closure /reset/governance-closure.json \
           --provider-manifest /reset/provider-disposition-manifest.json \
           --rehearsal-evidence /reset/clean-rehearsal-evidence.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --operator-discord-user-id "$DOCKET_OPERATOR_DISCORD_USER_ID" \
           --deployment-revision "$RESET_DEPLOYMENT_REVISION" \
           --output /reset/production-reset-authority.json'
    authority_decision_ref=$(json_field "$authority_evidence" decision_ref)
    authority_audit_ref=$(json_field "$authority_evidence" audit_ref)

    compose stop -t 30 discord-ingress hermes docket
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -e "DOCKET_DATABASE_URL=$database_url" \
        -v "$evidence_dir:/output" \
        -v "$ROOT/deltas/docket-ontology-readiness-status-08-27-2026.yaml:/input/ontology-readiness.yaml:ro" \
        docket ./.venv/bin/python -m docket.tracked_context_readiness \
        export-governance --database-url "$database_url" \
        --seed-file /input/ontology-readiness.yaml \
        --seed-ref "$authority_decision_ref" \
        --seed-ref "$authority_audit_ref" \
        --output /output/final-governance-closure.json
    docker_engine run --rm --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        docket-docket:latest ./.venv/bin/python -m docket.production_cutover \
        verify-closure-extension \
        --sealed-closure /reset/governance-closure.json \
        --final-closure /reset/final-governance-closure.json \
        --authority-evidence /reset/production-reset-authority.json \
        --output /reset/final-governance-extension.json

    [[ "$(database_exists "$clean_database")" == "0" ]] ||
        die "clean cutover database already exists: $clean_database"
    compose exec -T postgres createdb -U docket "$clean_database"
    clean_created=1
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        -e "DOCKET_DATABASE_URL=$clean_database_url" \
        docket sh -ec \
        './.venv/bin/python -m docket.tracked_context_readiness materialize-clean \
           --closure /reset/final-governance-closure.json \
           --provider-manifest /reset/provider-disposition-manifest.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --output /reset/clean-materialization.json'
    compose run --rm --no-deps -e "DOCKET_DATABASE_URL=$clean_database_url" \
        docket ./.venv/bin/docket-provision-ingress-role
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        -e "DOCKET_DATABASE_URL=$clean_database_url" \
        docket sh -ec \
        './.venv/bin/python -m docket.production_cutover verify-authority \
           --manifest /reset/production-reset-manifest.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --operator-discord-user-id "$DOCKET_OPERATOR_DISCORD_USER_ID" \
           --output /reset/clean-authority-verification.json'

    compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'docket' AND pid <> pg_backend_pid();" \
        >/dev/null
    compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
        "ALTER DATABASE docket RENAME TO $quarantine_database;" >/dev/null
    old_renamed=1
    compose exec -T postgres psql -U docket -d postgres -v ON_ERROR_STOP=1 -c \
        "ALTER DATABASE $clean_database RENAME TO docket;" >/dev/null
    clean_created=0

    compose up -d --no-build --force-recreate docket hermes discord-ingress
    clear_hermes_drain
    wait_for_hermes "$log_first_line"
    postdeploy
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        docket sh -ec \
        './.venv/bin/python -m docket.production_cutover verify-authority \
           --manifest /reset/production-reset-manifest.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --operator-discord-user-id "$DOCKET_OPERATOR_DISCORD_USER_ID" \
           --output /reset/clean-authority-verification.json'
    compose run --rm --no-deps --user "$(id -u):$(id -g)" \
        -v "$evidence_dir:/reset" \
        docket sh -ec \
        './.venv/bin/python -m docket.production_cutover record-completion \
           --manifest /reset/production-reset-manifest.json \
           --closure-extension /reset/final-governance-extension.json \
           --database-url "$DOCKET_DATABASE_URL" \
           --operator-discord-user-id "$DOCKET_OPERATOR_DISCORD_USER_ID" \
           --output /reset/production-reset-completion.json'
    gmail_triage_setup
    drop_cutover_database "$quarantine_database"
    reset_complete=1
    trap - EXIT INT TERM
    printf 'Production reset completed at revision %s.\n' "$revision"
    printf 'Sealed backup retained at %s.\n' "$backup"
    printf 'Governance extension: %s\n' "$closure_extension"
    printf 'Clean materialization: %s\n' "$materialization"
    printf 'Clean authority verification: %s\n' "$clean_authority"
    printf 'Completion audit evidence: %s\n' "$completion_evidence"
)

verify_restore() {
    "$ROOT/scripts/verify-restore.sh" "${1:-}"
}

usage() {
    cat <<'EOF'
Usage: scripts/docket COMMAND

Commands:
  check           Run the frozen test, lint, and type-check suite safely.
  compose-smoke   Build and smoke an isolated dummy Postgres+Docket stack.
  build           Validate Compose and build a revision-labelled Docket image.
  predeploy       Verify source, CI, environment, and durable-state gates.
  deploy          Back up PostgreSQL, rebuild/recreate, and verify the live stack.
  deploy-ingress  Replace only stable Discord ingress through a quiesced handoff.
  backup          Create or confirm today's encrypted PostgreSQL backup.
  verify-restore  Restore an encrypted backup into disposable PostgreSQL and verify it.
  readiness-rehearsal
                  Snapshot production, rehearse reset, and seal exact authorization text.
  production-reset EVIDENCE_DIR --execute
                  Execute the exact authorized clean reset and verified cutover.
  setup-triage    Install the isolated Hermes Gmail-triage profile and cron.
  setup-hermes-auth [--main|--triage|--all]
                  Reauthorize Hermes's OpenAI Codex model credential.
  gmail-status    Report Gmail gates, checkpoint freshness, and source counts.
  gmail-scan      Force one bounded metadata scan; never invokes semantic triage.
  gmail-propose-archive SOURCE_ID SOURCE_VERSION REQUEST_KEY
                  Propose archiving one exact classified Gmail source version.
  gmail-reconcile-operation OPERATION_ID REQUEST_KEY
                  Reconcile a known post-call Gmail invalid-response failure.
  gmail-triage-status  Verify the single triage job and show its recent runs.
  gmail-triage-pause   Pause semantic triage without changing Gmail ingestion.
  gmail-triage-run     Queue one isolated semantic-triage run.
  gmail-triage-resume  Resume the isolated 5-minute semantic-triage schedule.
  status          Show source, service, and bounded durable-state status.
EOF
}

case "${1:-}" in
    check) check ;;
    compose-smoke) compose_smoke ;;
    build) build_image ;;
    predeploy) predeploy ;;
    deploy) deploy ;;
    deploy-ingress) deploy_ingress ;;
    backup) encrypted_backup ;;
    verify-restore) verify_restore "${2:-}" ;;
    readiness-rehearsal) tracked_context_readiness ;;
    production-reset) production_reset "${2:-}" "${3:-}" ;;
    setup-triage) gmail_triage_setup ;;
    setup-hermes-auth) hermes_oauth_setup "${2:---main}" ;;
    gmail-status) gmail status ;;
    gmail-scan) gmail scan ;;
    gmail-propose-archive)
        gmail propose-archive "${2:-}" "${3:-}" "${4:-}"
        ;;
    gmail-reconcile-operation)
        gmail reconcile-operation "${2:-}" "${3:-}"
        ;;
    gmail-triage-status) gmail_triage_control status ;;
    gmail-triage-pause) gmail_triage_control pause ;;
    gmail-triage-run) gmail_triage_control run ;;
    gmail-triage-resume) gmail_triage_control resume ;;
    status) status ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
