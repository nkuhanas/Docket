#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

DOCKER_COMMAND=()

die() {
    printf 'docket: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

init_docker() {
    if ((${#DOCKER_COMMAND[@]})); then
        return
    fi
    require_command docker
    if docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(docker)
    elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(
            sudo -n
            --preserve-env=DOCKET_SERVICE_ENV_FILE,DOCKET_BUILD_REVISION,DOCKET_PORT,DOCKET_IMAGE
            --preserve-env=DOCKET_DISCORD_PROJECTION_ENABLED,DOCKET_CREDENTIALS_DIR
            docker
        )
    else
        die "Docker is unavailable; grant access or run 'sudo -v' first"
    fi
}

docker_engine() {
    init_docker
    "${DOCKER_COMMAND[@]}" "$@"
}

compose() {
    init_docker
    "${DOCKER_COMMAND[@]}" compose "$@"
}

safe_test_environment() {
    mkdir -p "$ROOT/.runtime"
    export DOCKET_ENVIRONMENT=test
    export DOCKET_PLUGIN_ENABLED=false
    export DOCKET_DISCORD_ADAPTER_ENABLED=true
    export DOCKET_OPERATOR_REF=
    export DOCKET_DATABASE_URL="sqlite+pysqlite:///$ROOT/.runtime/check.db"
    export DOCKET_AUTO_CREATE_SCHEMA=true
    export DOCKET_CALENDAR_READS_ENABLED=false
    export DOCKET_TASKS_ENABLED=false
    export DOCKET_EXTERNAL_WRITES_ENABLED=false
    export DOCKET_GMAIL_INGESTION_ENABLED=false
    export DOCKET_GMAIL_WRITES_ENABLED=false
    export DOCKET_GMAIL_TRIAGE_SOURCE_ALLOWLIST='[]'
    export DOCKET_BACKUP_ENABLED=false
    export DOCKET_BACKUP_AGE_RECIPIENT=
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    export DOCKET_TRIAGE_TOKEN_FILE="$ROOT/secrets/smoke/docket_triage_token"
    unset DOCKET_READ_ONLY_TOKEN_FILE
    export DOCKET_INTERACTIVE_AGENT_ENABLED=true
    unset DOCKET_INTERACTIVE_AGENT_EXPIRES_AT
    export DOCKET_TO_HERMES_TOKEN_FILE="$ROOT/secrets/smoke/docket_to_hermes_token"
    export HERMES_TO_DOCKET_TOKEN_FILE="$ROOT/secrets/smoke/hermes_to_docket_token"
    export DOCKET_INTERACTION_SIGNING_KEY_FILE="$ROOT/secrets/smoke/interaction_signing_key"
    export DOCKET_ATTACHMENT_ENCRYPTION_KEY_FILE="$ROOT/secrets/smoke/attachment_encryption_key"
    export GOOGLE_OAUTH_CLIENT_FILE="$ROOT/secrets/smoke/google_oauth_client.json"
    export GOOGLE_OAUTH_TOKEN_FILE="$ROOT/secrets/smoke/google_oauth_token.json"
}

check() {
    require_command uv
    safe_test_environment
    local group=${1:-native}
    [[ "$group" != "--extended" ]] || group=${2:-all}
    python3 "$ROOT/scripts/local_ci.py" check "$group"
}

check_groups() {
    safe_test_environment
    python3 "$ROOT/scripts/local_ci.py" check "$@"
}

compose_smoke() (
    init_docker
    export DOCKET_SERVICE_ENV_FILE="$ROOT/.env.example"
    export DOCKET_CREDENTIALS_DIR="$ROOT/secrets/smoke"
    export DOCKET_DATABASE_URL=postgresql+psycopg://docket:docket-smoke@postgres:5432/docket
    export POSTGRES_PASSWORD=docket-smoke
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    local project=${DOCKET_SMOKE_PROJECT:-docket-native-smoke-${UID:-local}}
    smoke_compose() {
        compose --project-name "$project" --env-file "$ROOT/.env.example" "$@"
    }
    cleanup() {
        local result=$?
        smoke_compose down --volumes --remove-orphans >/dev/null 2>&1 || true
        return "$result"
    }
    trap cleanup EXIT
    # A supplied immutable image is tested as-is, never rebuilt after validation.
    if [[ -z "${DOCKET_IMAGE:-}" ]]; then
        export DOCKET_BUILD_REVISION
        DOCKET_BUILD_REVISION=$(git rev-parse HEAD 2>/dev/null || printf unknown)
        smoke_compose build docket
    fi
    smoke_compose up -d --wait --wait-timeout 120 postgres
    smoke_compose run -T --rm --no-deps docket ./.venv/bin/alembic upgrade head
    smoke_compose run -T --rm --no-deps \
        -e DOCKET_ENVIRONMENT=test \
        -e DOCKET_PLUGIN_ENABLED=true -e DOCKET_DISCORD_ADAPTER_ENABLED=false \
        -e DOCKET_INTERACTIVE_AGENT_ENABLED=false \
        -e DOCKET_PLUGIN_OAUTH_ISSUER=https://identity.test/ \
        -e DOCKET_PLUGIN_OAUTH_JWKS_URL=https://identity.test/.well-known/jwks.json \
        -e 'DOCKET_PLUGIN_OAUTH_CLIENT_IDS=["synthetic-native-client"]' \
        -e DOCKET_TO_HERMES_TOKEN_FILE=/nonexistent/unused \
        -e HERMES_TO_DOCKET_TOKEN_FILE=/nonexistent/unused \
        -e DOCKET_INGRESS_DB_PASSWORD_FILE=/nonexistent/unused \
        docket ./.venv/bin/python - < "$ROOT/scripts/plugin-native-smoke.py"
    if [[ "${1:-}" == "--extended" ]]; then
        smoke_compose exec -T postgres createdb -U docket docket_storage_smoke
        local database_url=postgresql+psycopg://docket:docket-smoke@postgres:5432/docket_storage_smoke
        smoke_compose run -T --rm --no-deps -e "DOCKET_DATABASE_URL=$database_url" \
            docket ./.venv/bin/alembic upgrade head
        smoke_compose run -T --rm --no-deps -e "DOCKET_DATABASE_URL=$database_url" \
            docket ./.venv/bin/alembic downgrade 20260905f4c1
        smoke_compose run -T --rm --no-deps -e "DOCKET_DATABASE_URL=$database_url" \
            docket ./.venv/bin/alembic upgrade head
        smoke_compose run -T --rm --no-deps -e "DOCKET_DATABASE_URL=$database_url" \
            -v "$ROOT:/workspace:ro" docket ./.venv/bin/python \
            /workspace/scripts/compose-assembly-postgres-smoke.py --native
        smoke_compose exec -T postgres createdb -U docket docket_work_smoke
        smoke_compose run -T --rm --no-deps \
            -e DOCKET_ENVIRONMENT=test \
            -e DOCKET_DATABASE_URL=postgresql+psycopg://docket:docket-smoke@postgres:5432/docket_work_smoke \
            -v "$ROOT:/workspace:ro" docket ./.venv/bin/python \
            /workspace/scripts/work-postgres-check.py
    fi
)

build_image() {
    init_docker
    local revision
    local short_revision
    local image_id
    revision=$(git rev-parse HEAD 2>/dev/null || printf unknown)
    short_revision=${revision:0:12}
    export DOCKET_BUILD_REVISION="$revision"
    compose config --quiet
    compose build docket
    image_id=$(docker_engine image inspect docket-docket:latest --format '{{.Id}}')
    [[ -n "$image_id" ]] || die "Docket image was built but could not be identified"
    docker_engine image tag "$image_id" "docket-docket:$short_revision"
    printf 'Built docket-docket:%s (%s)\n' "$short_revision" "$image_id"
}

env_value() {
    local key=$1
    awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' \
        "$ROOT/.env"
}

discord_adapter_enabled() {
    local value
    value=$(env_value DOCKET_DISCORD_ADAPTER_ENABLED)
    value=${value#\"}; value=${value%\"}
    value=${value#\'}; value=${value%\'}
    case "${value,,}" in
        ""|true|1|yes|on) return 0 ;;
        false|0|no|off) return 1 ;;
        *) die "DOCKET_DISCORD_ADAPTER_ENABLED must be a boolean" ;;
    esac
}

operational_counts() {
    local counts operations outbox native=0
    counts=$(compose exec -T postgres psql -U docket -d docket -Atc \
        "select
           (select count(*) from operations
             where status = 'running')
           || ' ' ||
           (select count(*) from outbox_events
             where status = 'delivering');")
    read -r operations outbox <<<"$counts"
    if [[ "$(compose exec -T postgres psql -U docket -d docket -Atc \
        "select to_regclass('public.mcp_event_deliveries') is not null;")" == "t" ]]; then
        native=$(compose exec -T postgres psql -U docket -d docket -Atc \
            "select count(*) from mcp_event_deliveries where status = 'running';")
    fi
    printf '%s %s\n' "$operations" "$((outbox + native))"
}

assert_operationally_idle() {
    local counts
    local operations
    local outbox
    counts=$(operational_counts)
    read -r operations outbox <<<"$counts"
    [[ "$operations" == "0" ]] ||
        die "deployment blocked: $operations provider operation(s) are executing"
    [[ "$outbox" == "0" ]] ||
        die "deployment blocked: $outbox outbox delivery or deliveries are in flight"
}

wait_for_operational_idle() {
    local attempt
    local counts
    for attempt in {1..30}; do
        counts=$(operational_counts)
        if [[ "$counts" == "0 0" ]]; then
            return
        fi
        sleep 1
    done
    assert_operationally_idle
}


activate_validated_image() {
    export DOCKET_IMAGE
    DOCKET_IMAGE=$(python3 "$ROOT/scripts/local_ci.py" image)
    [[ "$DOCKET_IMAGE" == sha256:* ]] || die "validated immutable image is unavailable"
}

predeploy() {
    require_command git
    [[ -f "$ROOT/.env" ]] || die "deployment requires $ROOT/.env"
    [[ "$(env_value DOCKET_ENVIRONMENT)" == "production" ]] ||
        die "deployment requires DOCKET_ENVIRONMENT=production"
    [[ -z "$(git status --porcelain)" ]] || die "deployment requires a clean worktree"
    [[ "$(git branch --show-current)" == "main" ]] || die "deployment requires the main branch"
    git fetch --quiet origin main
    [[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] ||
        die "HEAD must exactly match origin/main"
    if discord_adapter_enabled; then
        die "the retired Discord adapter must be disabled"
    fi
    [[ "$(env_value DOCKET_PLUGIN_ENABLED)" == "true" ]] || die "native plugin must be enabled"
    activate_validated_image
    init_docker
    [[ -n "$(compose ps -q postgres)" ]] || die "production PostgreSQL is not running"
    printf 'Predeploy passed for source %s and tested image %s\n' "$(git rev-parse HEAD)" "$DOCKET_IMAGE"
}


ensure_attachment_encryption_key() {
    local configured_credentials_dir
    local credential_path
    local retained_blob_count=0
    configured_credentials_dir=$(env_value DOCKET_CREDENTIALS_DIR)
    case "$configured_credentials_dir" in
        /*) credential_path="$configured_credentials_dir/attachment_encryption_key" ;;
        *) credential_path="$ROOT/${configured_credentials_dir#./}/attachment_encryption_key" ;;
    esac
    if [[ -s "$credential_path" ]]; then
        [[ "$(tr -d '\r\n' <"$credential_path")" =~ ^[0-9a-fA-F]{64}$ ]] ||
            die "attachment encryption key must contain exactly 32 hexadecimal bytes"
        return
    fi
    if [[ -n "$(compose ps -q postgres)" ]]; then
        if [[ "$(compose exec -T postgres psql -U docket -d docket -Atc \
            "select to_regclass('public.encrypted_attachment_blobs') is not null;")" == "t" ]]; then
            retained_blob_count=$(compose exec -T postgres psql -U docket -d docket -Atc \
                "select count(*) from encrypted_attachment_blobs;")
        fi
        if [[ "$(compose exec -T postgres psql -U docket -d docket -Atc \
            "select to_regclass('public.mcp_event_subscriptions') is not null;")" == "t" ]]; then
            local retained_callback_count
            retained_callback_count=$(compose exec -T postgres psql -U docket -d docket -Atc \
                "select count(*) from mcp_event_subscriptions where octet_length(configuration) > 0;")
            retained_blob_count=$((retained_blob_count + retained_callback_count))
        fi
    fi
    [[ "$retained_blob_count" == "0" ]] ||
        die "encryption key is missing while encrypted evidence or callbacks exist"
    mkdir -p "$(dirname "$credential_path")"
    umask 077
    require_command openssl
    openssl rand -hex 32 >"$credential_path"
    chmod 600 "$credential_path"
    printf 'Created the attachment evidence encryption key; retain it with credential backups.\n'
}





database_continuity() {
    if [[ -n "$(compose ps -q docket)" ]]; then
        compose exec -T docket ./.venv/bin/docket-continuity "$@"
        return
    fi
    compose run --rm --no-deps docket ./.venv/bin/docket-continuity "$@"
}

request_database_drain() {
    local principal=${1:-scripts/docket deploy}
    local output
    output=$(database_continuity request --requested-by "$principal")
    uv run python -c "import json,sys; print(json.load(sys.stdin)['ref'])" <<<"$output"
}

wait_for_database_drain() {
    local drain_ref=$1
    local attempt
    local output
    local status_line
    for attempt in {1..180}; do
        output=$(database_continuity status "$drain_ref")
        status_line=$(uv run python -c \
            "import json,sys; d=json.load(sys.stdin); print(f\"{int(d['drained'])} {int(d['timed_out'])}\")" \
            <<<"$output")
        [[ "$status_line" == "1 0" ]] && return
        [[ "$status_line" == "0 1" ]] && {
            printf '%s\n' "$output" >&2
            return 1
        }
        sleep 1
    done
    return 1
}

backup_database() {
    local revision
    local timestamp
    local destination
    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    destination="$ROOT/backups/docket-$timestamp-$revision.dump"
    if [[ ! -d "$ROOT/backups" ]]; then
        mkdir -p "$ROOT/backups"
    fi
    if [[ ! -w "$ROOT/backups" ]]; then
        command -v sudo >/dev/null 2>&1 ||
            die "backup directory is not writable and sudo is unavailable: $ROOT/backups"
        sudo -n chown -- "$(id -u):$(id -g)" "$ROOT/backups" ||
            die "could not assign the backup directory to the invoking operator"
        sudo -n chmod 700 "$ROOT/backups" ||
            die "could not restrict backup directory permissions"
    fi
    umask 077
    compose exec -T postgres pg_dump -U docket -d docket --format=custom >"$destination"
    [[ -s "$destination" ]] || die "database backup is empty: $destination"
    chmod 600 "$destination" ||
        die "could not restrict database backup permissions: $destination"
    printf '%s\n' "$destination"
}

wait_for_docket() {
    local attempt
    for attempt in {1..60}; do
        if compose exec -T docket python -c \
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" \
            >/dev/null 2>&1; then
            return
        fi
        sleep 2
    done
    die "Docket did not become healthy within 120 seconds"
}


postdeploy() {
    wait_for_docket
    compose exec -T docket ./.venv/bin/alembic current | rg -q '\(head\)' ||
        die "Docket database is not at the Alembic head"
    compose exec -T docket ./.venv/bin/python - < "$ROOT/scripts/plugin-runtime-readiness.py"
    assert_operationally_idle
}

retire_gateway_containers() {
    # Removed Compose services may still have old stopped/running containers.
    # Match only this project's exact retired service labels; preserve volumes.
    local service
    local container
    for service in hermes searxng discord-ingress discord-ingress-handoff; do
        while IFS= read -r container; do
            [[ -z "$container" ]] || docker_engine stop -t 30 "$container" >/dev/null
        done < <(docker_engine ps -aq --filter label=com.docker.compose.project=docket \
            --filter "label=com.docker.compose.service=$service")
    done
}

deploy() {
    predeploy
    local backup
    local drain_ref=""
    local old_container
    local old_image
    local rollback_tag=none
    local revision
    local timestamp
    deploy_failure_cleanup() {
        local failed_drain_ref=$1
        if [[ -n "$failed_drain_ref" ]]; then
            database_continuity abort "$failed_drain_ref" >/dev/null 2>&1 || true
        fi
        printf 'Deployment failed; released the drain barrier without killing active work.\n' >&2
    }
    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    ensure_attachment_encryption_key
    old_container=$(compose ps -q docket)
    if [[ -n "$old_container" ]]; then
        old_image=$(docker_engine inspect --format '{{.Image}}' "$old_container")
        rollback_tag="docket-docket:rollback-$timestamp"
        docker_engine image tag "$old_image" "$rollback_tag"
        printf 'Previous image retained as %s\n' "$rollback_tag"
    fi
    drain_ref=$(request_database_drain)
    trap "$(printf 'deploy_failure_cleanup %q' "$drain_ref")" EXIT
    printf 'Deployment drain requested: %s\n' "$drain_ref"
    if ! wait_for_database_drain "$drain_ref"; then
        die "deployment drain timed out; active work was not interrupted"
    fi
    wait_for_operational_idle
    backup=$(backup_database)
    printf 'Drained database backup created: %s\n' "$backup"
    retire_gateway_containers
    compose run --rm --no-deps docket ./.venv/bin/alembic upgrade head
    compose up -d --no-build --force-recreate docket
    postdeploy
    database_continuity release "$drain_ref" >/dev/null
    trap - EXIT
    printf 'Deployed %s using %s\nBackup: %s\nPrevious image: %s\n' \
        "$revision" "$DOCKET_IMAGE" "$backup" "$rollback_tag"
}


status() {
    printf 'Source: %s\n' "$(git log -1 --oneline)"
    init_docker
    compose ps
    if [[ -n "$(compose ps -q postgres)" ]]; then
        local counts
        counts=$(operational_counts)
        printf 'Executing operations / delivering outbox: %s\n' "$counts"
    fi
}

encrypted_backup() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.backup_cli backup
}





gmail() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.gmail_cli "$@"
}

calendar_recovery() {
    init_docker
    compose exec -T docket ./.venv/bin/docket-calendar-recovery "$@"
}

google_tasks() {
    init_docker
    compose exec -T docket ./.venv/bin/docket-tasks "$@"
}







verify_restore() {
    "$ROOT/scripts/verify-restore.sh" "${1:-}"
}

usage() {
    cat <<'EOF'
Usage: scripts/docket COMMAND

Commands:
  check [--extended GROUP]  Run native tests, Ruff and strict mypy; GROUP can be
                           provider, storage, release or all.
  compose-smoke [--extended]  Test native MCP on isolated PostgreSQL.
  validate-release  Validate committed source snapshot and its immutable image.
  verify-release    Verify current source and local release evidence.
  build             Build a development image (not release authorization).
  predeploy         Verify synchronized source, local evidence and configuration.
  deploy            Drain, back up, migrate and activate the tested image.
  backup            Create today's encrypted PostgreSQL backup.
  verify-restore    Verify an encrypted backup in disposable PostgreSQL.
  calendar-recover-auth status CHANGESET_REF
                  Inspect one ChangeSet's Calendar provider-operation states.
  calendar-recover-auth requeue-auth-failures CHANGESET_REF --execute
                  Requeue exact Google-auth failures after validating the credential.
  calendar-recover-auth requeue-after-reauth --execute --credential-sha256-stdin
                  Retry current auth-failed deliveries after a matching Google reauthorization.
  tasks status    Report current Google Tasks method admission without exposing credentials.
  tasks validate --targets-file CONTAINER_PATH [--report CONTAINER_PATH]
                  Probe the dedicated validation lists and retain grant-bound method evidence.
  gmail-status    Report Gmail gates, checkpoint freshness, and source counts.
  gmail-scan      Force one bounded metadata scan; never invokes semantic triage.
  gmail-propose-archive SOURCE_ID SOURCE_VERSION REQUEST_KEY
                  Propose archiving one exact classified Gmail source version.
  gmail-reconcile-operation OPERATION_ID REQUEST_KEY
                  Reconcile a known post-call Gmail invalid-response failure.
  status          Show source, service, and bounded durable-state status.
EOF
}

case "${1:-}" in
    check) check "${@:2}" ;;
    _check-groups) check_groups "${@:2}" ;;
    validate-release) python3 "$ROOT/scripts/local_ci.py" validate ;;
    verify-release) python3 "$ROOT/scripts/local_ci.py" verify ;;
    compose-smoke) compose_smoke "${@:2}" ;;
    build) build_image ;;
    predeploy) predeploy ;;
    deploy) deploy ;;
    backup) encrypted_backup ;;
    verify-restore) verify_restore "${2:-}" ;;
    calendar-recover-auth) calendar_recovery "${@:2}" ;;
    tasks) google_tasks "${@:2}" ;;
    gmail-status) gmail status ;;
    gmail-scan) gmail scan ;;
    gmail-propose-archive)
        gmail propose-archive "${2:-}" "${3:-}" "${4:-}"
        ;;
    gmail-reconcile-operation)
        gmail reconcile-operation "${2:-}" "${3:-}"
        ;;
    status) status ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
