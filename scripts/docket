#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

DOCKER_COMMAND=()

die() {
    printf 'docket: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

init_docker() {
    if ((${#DOCKER_COMMAND[@]})); then
        return
    fi
    require_command docker
    if docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(docker)
    elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
        DOCKER_COMMAND=(
            sudo -n
            --preserve-env=DOCKET_SERVICE_ENV_FILE,DOCKET_BUILD_REVISION,DOCKET_PORT
            --preserve-env=DOCKET_DISCORD_PROJECTION_ENABLED,DOCKET_CREDENTIALS_DIR
            docker
        )
    else
        die "Docker is unavailable; grant access or run 'sudo -v' first"
    fi
}

docker_engine() {
    init_docker
    "${DOCKER_COMMAND[@]}" "$@"
}

compose() {
    init_docker
    "${DOCKER_COMMAND[@]}" compose "$@"
}

safe_test_environment() {
    mkdir -p "$ROOT/.runtime"
    export DOCKET_ENVIRONMENT=test
    export DOCKET_DATABASE_URL="sqlite+pysqlite:///$ROOT/.runtime/check.db"
    export DOCKET_AUTO_CREATE_SCHEMA=true
    export DOCKET_CALENDAR_READS_ENABLED=false
    export DOCKET_EXTERNAL_WRITES_ENABLED=false
    export DOCKET_GMAIL_INGESTION_ENABLED=false
    export DOCKET_GMAIL_WRITES_ENABLED=false
    export DOCKET_GMAIL_TRIAGE_SOURCE_ALLOWLIST='[]'
    export DOCKET_BACKUP_ENABLED=false
    export DOCKET_BACKUP_AGE_RECIPIENT=
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    export DOCKET_TO_HERMES_TOKEN_FILE="$ROOT/secrets/smoke/docket_to_hermes_token"
    export HERMES_TO_DOCKET_TOKEN_FILE="$ROOT/secrets/smoke/hermes_to_docket_token"
    export DOCKET_INTERACTION_SIGNING_KEY_FILE="$ROOT/secrets/smoke/interaction_signing_key"
    export GOOGLE_OAUTH_CLIENT_FILE="$ROOT/secrets/smoke/google_oauth_client.json"
    export GOOGLE_OAUTH_TOKEN_FILE="$ROOT/secrets/smoke/google_oauth_token.json"
}

check() {
    require_command uv
    safe_test_environment
    uv sync --frozen
    uv run pytest
    uv run ruff check .
    uv run mypy
}

compose_smoke() (
    require_command uv
    init_docker

    local project=${DOCKET_SMOKE_PROJECT:-docket-smoke-${UID:-local}}
    local port=${DOCKET_SMOKE_PORT:-18080}
    export DOCKET_SERVICE_ENV_FILE="$ROOT/.env.example"
    export DOCKET_BUILD_REVISION
    DOCKET_BUILD_REVISION=$(git rev-parse HEAD 2>/dev/null || printf unknown)
    export DOCKET_PORT="$port"
    export DOCKET_DISCORD_PROJECTION_ENABLED=false
    export DOCKET_CREDENTIALS_DIR="$ROOT/secrets/smoke"
    export DOCKET_SMOKE_URL="http://127.0.0.1:$port"

    smoke_compose() {
        compose --project-name "$project" --env-file "$ROOT/.env.example" "$@"
    }
    cleanup() {
        local status=$?
        if ((status != 0)); then
            smoke_compose logs --no-color --tail 200 docket postgres >&2 || true
        fi
        smoke_compose down --volumes --remove-orphans >/dev/null 2>&1 || true
        return "$status"
    }
    trap cleanup EXIT INT TERM

    cleanup
    uv sync --frozen
    smoke_compose config --quiet
    smoke_compose up -d --build --wait --wait-timeout 180 postgres docket
    uv run python scripts/compose-mcp-smoke.py
    smoke_compose exec -T docket ./.venv/bin/python - <<'PY'
from sqlalchemy import create_engine, text
from sqlalchemy.exc import ProgrammingError

from docket.discord_ingress import ingress_database_url

engine = create_engine(ingress_database_url())
with engine.connect() as connection:
    assert connection.scalar(text("SELECT count(*) FROM persisted_semantic_options")) == 0
    try:
        connection.execute(text("UPDATE operator_utterances SET verbatim_text = verbatim_text"))
    except ProgrammingError:
        connection.rollback()
    else:
        raise AssertionError("restricted ingress role unexpectedly has UPDATE authority")
engine.dispose()
PY
)

build_image() {
    init_docker
    local revision
    local short_revision
    local image_id
    revision=$(git rev-parse HEAD 2>/dev/null || printf unknown)
    short_revision=${revision:0:12}
    export DOCKET_BUILD_REVISION="$revision"
    compose config --quiet
    compose build docket
    image_id=$(docker_engine image inspect docket-docket:latest --format '{{.Id}}')
    [[ -n "$image_id" ]] || die "Docket image was built but could not be identified"
    docker_engine image tag "$image_id" "docket-docket:$short_revision"
    printf 'Built docket-docket:%s (%s)\n' "$short_revision" "$image_id"
}

env_value() {
    local key=$1
    awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' \
        "$ROOT/.env"
}

operational_counts() {
    compose exec -T postgres psql -U docket -d docket -Atc \
        "select
           (select count(*) from operations
             where status = 'running')
           || ' ' ||
           (select count(*) from outbox_events
             where status = 'delivering');"
}

assert_operationally_idle() {
    local counts
    local operations
    local outbox
    counts=$(operational_counts)
    read -r operations outbox <<<"$counts"
    [[ "$operations" == "0" ]] ||
        die "deployment blocked: $operations provider operation(s) are executing"
    [[ "$outbox" == "0" ]] ||
        die "deployment blocked: $outbox outbox delivery or deliveries are in flight"
}

wait_for_operational_idle() {
    local attempt
    local counts
    for attempt in {1..30}; do
        counts=$(operational_counts)
        if [[ "$counts" == "0 0" ]]; then
            return
        fi
        sleep 1
    done
    assert_operationally_idle
}

repository_name() {
    gh repo view --json nameWithOwner --jq .nameWithOwner
}

predeploy() {
    require_command git
    require_command gh
    [[ -f "$ROOT/.env" ]] || die "deployment requires $ROOT/.env"
    [[ "$(env_value DOCKET_ENVIRONMENT)" == "production" ]] ||
        die "deployment requires DOCKET_ENVIRONMENT=production"
    [[ -z "$(git status --porcelain)" ]] || die "deployment requires a clean worktree"
    [[ "$(git branch --show-current)" == "main" ]] || die "deployment requires the main branch"

    git fetch --quiet origin main
    local revision
    local upstream
    local repo
    local conclusion
    revision=$(git rev-parse HEAD)
    upstream=$(git rev-parse origin/main)
    [[ "$revision" == "$upstream" ]] || die "HEAD must exactly match origin/main"
    repo=$(repository_name)
    conclusion=$(
        gh run list \
            --repo "$repo" \
            --workflow CI \
            --commit "$revision" \
            --limit 1 \
            --json status,conclusion \
            --jq 'if length == 0 then "missing" else .[0].status + ":" + (.[0].conclusion // "") end'
    )
    [[ "$conclusion" == "completed:success" ]] ||
        die "CI for $revision is not green (state: $conclusion)"

    init_docker
    [[ -n "$(compose ps -q postgres)" ]] || die "the production PostgreSQL service is not running"
    printf 'Predeploy passed for %s at %s\n' "$repo" "$revision"
}

ensure_ingress_credential() {
    local configured_credentials_dir
    local credential_path
    configured_credentials_dir=$(env_value DOCKET_CREDENTIALS_DIR)
    case "$configured_credentials_dir" in
        /*) credential_path="$configured_credentials_dir/discord_ingress_db_password" ;;
        *) credential_path="$ROOT/${configured_credentials_dir#./}/discord_ingress_db_password" ;;
    esac
    if [[ -s "$credential_path" ]]; then
        return
    fi
    mkdir -p "$(dirname "$credential_path")"
    umask 077
    require_command openssl
    openssl rand -hex 32 >"$credential_path"
    chmod 600 "$credential_path"
    printf 'Created the restricted Discord ingress database credential.\n'
}

request_hermes_drain() {
    local principal=${1:-scripts/docket deploy}
    compose exec -T hermes python -c \
        "from gateway.drain_control import write_drain_request; write_drain_request(principal='$principal', suppress_notification=True)" \
        >/dev/null
}

clear_hermes_drain() {
    compose exec -T hermes python -c \
        "from gateway.drain_control import clear_drain_request; clear_drain_request()" \
        >/dev/null 2>&1 || true
}

wait_for_hermes_drain() {
    local attempt
    local state
    for attempt in {1..180}; do
        if [[ -f "$ROOT/.runtime/hermes/gateway_state.json" ]]; then
            state=$(uv run python -c \
                "import json; d=json.load(open('.runtime/hermes/gateway_state.json')); print(f\"{d.get('gateway_state')} {d.get('active_agents', -1)}\")")
            if [[ "$state" == "draining 0" ]]; then
                return
            fi
        fi
        sleep 1
    done
    die "Hermes did not reach draining with zero active turns within 180 seconds"
}

wait_for_discord_ingress() {
    local service=${1:-discord-ingress}
    local attempt
    local container
    local health
    container=$(compose ps -q "$service")
    [[ -n "$container" ]] || die "$service is not running"
    for attempt in {1..120}; do
        health=$(docker_engine inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")
        [[ "$health" == "healthy" ]] && return
        [[ "$health" == "unhealthy" || "$health" == "exited" ]] && break
        sleep 1
    done
    die "$service did not become healthy"
}

database_continuity() {
    compose run --rm --no-deps docket ./.venv/bin/docket-continuity "$@"
}

request_database_drain() {
    local output
    output=$(database_continuity request --requested-by "scripts/docket deploy")
    uv run python -c "import json,sys; print(json.load(sys.stdin)['ref'])" <<<"$output"
}

wait_for_database_drain() {
    local drain_ref=$1
    local attempt
    local output
    local status_line
    for attempt in {1..180}; do
        output=$(database_continuity status "$drain_ref")
        status_line=$(uv run python -c \
            "import json,sys; d=json.load(sys.stdin); print(f\"{int(d['drained'])} {int(d['timed_out'])}\")" \
            <<<"$output")
        [[ "$status_line" == "1 0" ]] && return
        [[ "$status_line" == "0 1" ]] && {
            printf '%s\n' "$output" >&2
            return 1
        }
        sleep 1
    done
    return 1
}

backup_database() {
    local revision
    local timestamp
    local destination
    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    destination="$ROOT/backups/docket-$timestamp-$revision.dump"
    if [[ ! -d "$ROOT/backups" ]]; then
        mkdir -p "$ROOT/backups"
    fi
    if [[ ! -w "$ROOT/backups" ]]; then
        command -v sudo >/dev/null 2>&1 ||
            die "backup directory is not writable and sudo is unavailable: $ROOT/backups"
        sudo -n chown -- "$(id -u):$(id -g)" "$ROOT/backups" ||
            die "could not assign the backup directory to the invoking operator"
        sudo -n chmod 700 "$ROOT/backups" ||
            die "could not restrict backup directory permissions"
    fi
    umask 077
    compose exec -T postgres pg_dump -U docket -d docket --format=custom >"$destination"
    [[ -s "$destination" ]] || die "database backup is empty: $destination"
    chmod 600 "$destination" ||
        die "could not restrict database backup permissions: $destination"
    printf '%s\n' "$destination"
}

wait_for_docket() {
    local attempt
    for attempt in {1..60}; do
        if compose exec -T docket python -c \
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" \
            >/dev/null 2>&1; then
            return
        fi
        sleep 2
    done
    die "Docket did not become healthy within 120 seconds"
}

wait_for_hermes() {
    local first_line=$1
    local attempt
    local expected_tool_count
    local segment
    expected_tool_count=$(
        uv run python -c \
            "import runpy; from pathlib import Path; m=runpy.run_path('scripts/sync_hermes_docket_config.py'); print(len(m['_tool_block'](Path('hermes/config.example.yaml').read_text()).splitlines()))"
    )
    for attempt in {1..60}; do
        if [[ -f "$ROOT/.runtime/hermes/logs/agent.log" ]]; then
            segment=$(tail -n +"$first_line" "$ROOT/.runtime/hermes/logs/agent.log")
            if rg -q '\[Discord\] Connected as ' <<<"$segment" &&
                rg -q "registered ${expected_tool_count} tool\\(s\\)" <<<"$segment" &&
                rg -q 'Gateway running with 1 platform\(s\)' <<<"$segment"; then
                return
            fi
        fi
        sleep 2
    done
    die "Hermes did not connect to Discord with the expected MCP registry within 120 seconds"
}

postdeploy() {
    local expected_plugin_version
    local plugin_line
    wait_for_docket
    wait_for_discord_ingress
    compose exec -T docket ./.venv/bin/alembic current | rg -q '\(head\)' ||
        die "Docket database is not at the Alembic head"
    expected_plugin_version=$(
        awk '$1 == "version:" { print $2; exit }' \
            "$ROOT/hermes/plugin/docket_discord/plugin.yaml"
    )
    plugin_line=$(compose exec -T hermes hermes plugins list --plain --no-bundled |
        rg 'docket-discord')
    rg -q "enabled[[:space:]]+user[[:space:]]+$expected_plugin_version[[:space:]]+docket-discord" \
        <<<"$plugin_line" ||
        die "Hermes did not load docket-discord $expected_plugin_version"
    compose exec -T hermes python -c \
        "import socket; s=socket.create_connection(('127.0.0.1',8787),3); s.close()" ||
        die "Hermes projection listener is unreachable"
    assert_operationally_idle
}

deploy() {
    predeploy
    local backup
    local drain_ref=""
    local old_container
    local old_image
    local rollback_tag
    local log_first_line=1
    local revision
    local timestamp
    local cleanup_on_failure=0

    deploy_failure_cleanup() {
        if ((cleanup_on_failure)); then
            if [[ -n "$drain_ref" ]]; then
                database_continuity abort "$drain_ref" >/dev/null 2>&1 || true
            fi
            clear_hermes_drain
            printf 'Deployment failed; released the drain barrier without killing active work.\n' >&2
        fi
    }

    revision=$(git rev-parse --short=12 HEAD)
    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    ensure_ingress_credential
    old_container=$(compose ps -q docket)
    if [[ -n "$old_container" ]]; then
        old_image=$(docker_engine inspect --format '{{.Image}}' "$old_container")
        rollback_tag="docket-docket:rollback-$timestamp"
        docker_engine image tag "$old_image" "$rollback_tag"
        printf 'Previous image retained as %s\n' "$rollback_tag"
    else
        rollback_tag="none"
    fi
    "$ROOT/scripts/prepare-hermes-home.sh"
    if [[ -f "$ROOT/.runtime/hermes/logs/agent.log" ]]; then
        log_first_line=$(( $(wc -l <"$ROOT/.runtime/hermes/logs/agent.log") + 1 ))
    fi

    build_image
    if [[ -z "$(compose ps -q discord-ingress)" ]]; then
        backup=$(backup_database)
        printf 'Pre-bootstrap database backup created: %s\n' "$backup"
        compose run --rm --no-deps docket sh -c \
            './.venv/bin/alembic upgrade head && ./.venv/bin/docket-provision-ingress-role'
        compose up -d --no-build --wait --wait-timeout 120 discord-ingress
        printf 'Started deployment-stable Discord ingress.\n'
    fi
    wait_for_discord_ingress
    drain_ref=$(request_database_drain)
    cleanup_on_failure=1
    trap deploy_failure_cleanup EXIT
    printf 'Deployment drain requested: %s\n' "$drain_ref"
    request_hermes_drain
    if ! wait_for_hermes_drain || ! wait_for_database_drain "$drain_ref"; then
        database_continuity abort "$drain_ref" >/dev/null || true
        clear_hermes_drain
        die "deployment drain timed out; active work was not interrupted"
    fi
    wait_for_operational_idle
    backup=$(backup_database)
    printf 'Drained database backup created: %s\n' "$backup"
    compose run --rm --no-deps docket sh -c \
        './.venv/bin/alembic upgrade head && ./.venv/bin/docket-provision-ingress-role'
    compose up -d --no-build --force-recreate docket hermes
    wait_for_hermes "$log_first_line"
    clear_hermes_drain
    database_continuity release "$drain_ref" >/dev/null
    gmail_triage_setup
    postdeploy
    cleanup_on_failure=0
    trap - EXIT
    printf 'Deployed %s\nBackup: %s\nPrevious image: %s\n' \
        "$revision" "$backup" "$rollback_tag"
}

deploy_ingress() {
    predeploy
    local drain_ref=""
    local cleanup_on_failure=0
    local options_quiesced=0

    ingress_failure_cleanup() {
        if ((cleanup_on_failure)); then
            if ((options_quiesced)); then
                database_continuity regenerate-ingress-options >/dev/null 2>&1 || true
            fi
            if [[ -n "$drain_ref" ]]; then
                database_continuity abort "$drain_ref" >/dev/null 2>&1 || true
            fi
            clear_hermes_drain
            printf 'Ingress deployment failed; the handoff writer was left running if started.\n' >&2
        fi
    }

    ensure_ingress_credential
    [[ -n "$(compose ps -q discord-ingress)" ]] ||
        die "ingress-only deployment requires the stable ingress to be running"
    compose exec -T docket ./.venv/bin/alembic current | rg -q '\(head\)' ||
        die "ingress-only deployment requires the database at the current Alembic head"
    build_image
    drain_ref=$(request_database_drain)
    cleanup_on_failure=1
    trap ingress_failure_cleanup EXIT
    request_hermes_drain "scripts/docket deploy-ingress"
    if ! wait_for_hermes_drain || ! wait_for_database_drain "$drain_ref"; then
        die "ingress deployment drain timed out; active work was not interrupted"
    fi
    wait_for_operational_idle
    database_continuity quiesce-ingress-options >/dev/null
    options_quiesced=1

    compose --profile ingress-handoff up -d --no-build --force-recreate \
        discord-ingress-handoff
    wait_for_discord_ingress discord-ingress-handoff
    compose up -d --no-build --force-recreate discord-ingress
    wait_for_discord_ingress discord-ingress
    compose --profile ingress-handoff stop discord-ingress-handoff >/dev/null
    compose --profile ingress-handoff rm -f discord-ingress-handoff >/dev/null

    database_continuity regenerate-ingress-options >/dev/null
    options_quiesced=0
    clear_hermes_drain
    database_continuity release "$drain_ref" >/dev/null
    postdeploy
    cleanup_on_failure=0
    trap - EXIT
    printf 'Deployed the Discord ingress through a quiesced rolling handoff.\n'
}

status() {
    printf 'Source: %s\n' "$(git log -1 --oneline)"
    init_docker
    compose ps
    if [[ -n "$(compose ps -q postgres)" ]]; then
        local counts
        counts=$(operational_counts)
        printf 'Executing operations / delivering outbox: %s\n' "$counts"
    fi
}

encrypted_backup() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.backup_cli backup
}

gmail_triage_setup() {
    init_docker
    DOCKET_HERMES_HOME="$ROOT/.runtime/hermes" \
        "$ROOT/scripts/setup-hermes-triage.sh"
}

hermes_oauth_setup() {
    DOCKET_HERMES_HOME="$ROOT/.runtime/hermes" \
        "$ROOT/scripts/setup-hermes-oauth.sh" "${1:---main}"
}

gmail_triage_job_id() {
    local job_name="Docket Gmail triage"
    local listing
    local -a job_ids=()

    listing=$(compose exec -T hermes env NO_COLOR=1 hermes cron list --all)
    mapfile -t job_ids < <(
        awk -v wanted="$job_name" '
            /^  [[:alnum:]]+/ {
                candidate = $1
                next
            }
            /^[[:space:]]+Name:/ {
                name = $0
                sub(/^[[:space:]]+Name:[[:space:]]*/, "", name)
                if (name == wanted) {
                    print candidate
                }
            }
        ' <<<"$listing"
    )
    ((${#job_ids[@]} == 1)) ||
        die "expected exactly one '$job_name' cron job; found ${#job_ids[@]}"
    printf '%s\n' "${job_ids[0]}"
}

gmail_triage_control() {
    local command=$1
    local job_id
    local listing

    init_docker
    job_id=$(gmail_triage_job_id)
    case "$command" in
        status)
            compose exec -T hermes env NO_COLOR=1 hermes cron list --all
            compose exec -T hermes env NO_COLOR=1 hermes cron runs --limit 10 "$job_id"
            compose exec -T hermes env NO_COLOR=1 hermes cron status
            ;;
        pause|resume)
            compose exec -T hermes hermes cron "$command" "$job_id"
            ;;
        run)
            listing=$(compose exec -T hermes env NO_COLOR=1 hermes cron list --all)
            awk -v job_id="$job_id" '
                $1 == job_id && index($0, "[paused]") {
                    found = 1
                }
                END {
                    exit(found ? 0 : 1)
                }
            ' <<<"$listing" ||
                die "one-shot triage requires the recurring job to be paused"
            compose exec -T hermes env \
                PATH=/opt/hermes/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                /opt/data/scripts/docket-gmail-triage.sh
            ;;
        *)
            die "unsupported Gmail triage control: $command"
            ;;
    esac
}

soak() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.soak_cli "$1"
}

gmail() {
    init_docker
    compose exec -T docket ./.venv/bin/python -m docket.gmail_cli "$@"
}

verify_restore() {
    "$ROOT/scripts/verify-restore.sh" "${1:-}"
}

usage() {
    cat <<'EOF'
Usage: scripts/docket COMMAND

Commands:
  check           Run the frozen test, lint, and type-check suite safely.
  compose-smoke   Build and smoke an isolated dummy Postgres+Docket stack.
  build           Validate Compose and build a revision-labelled Docket image.
  predeploy       Verify source, CI, environment, and durable-state gates.
  deploy          Back up PostgreSQL, rebuild/recreate, and verify the live stack.
  deploy-ingress  Replace only stable Discord ingress through a quiesced handoff.
  backup          Create or confirm today's encrypted PostgreSQL backup.
  verify-restore  Restore an encrypted backup into disposable PostgreSQL and verify it.
  setup-triage    Install the isolated Hermes Gmail-triage profile and cron.
  setup-hermes-auth [--main|--triage|--all]
                  Reauthorize Hermes's OpenAI Codex model credential.
  gmail-status    Report Gmail gates, checkpoint freshness, and source counts.
  gmail-scan      Force one bounded metadata scan; never invokes semantic triage.
  gmail-propose-archive SOURCE_ID SOURCE_VERSION REQUEST_KEY
                  Propose archiving one exact classified Gmail source version.
  gmail-reconcile-operation OPERATION_ID REQUEST_KEY
                  Reconcile a known post-call Gmail invalid-response failure.
  gmail-triage-status  Verify the single triage job and show its recent runs.
  gmail-triage-pause   Pause semantic triage without changing Gmail ingestion.
  gmail-triage-run     Queue one isolated semantic-triage run.
  gmail-triage-resume  Resume the isolated 5-minute semantic-triage schedule.
  soak-start      Start or report the current durable 72-hour soak.
  soak-status     Report soak duration, gate checks, and visible incidents.
  soak-complete   Complete the soak only after duration and every gate pass.
  status          Show source, service, and bounded durable-state status.
EOF
}

case "${1:-}" in
    check) check ;;
    compose-smoke) compose_smoke ;;
    build) build_image ;;
    predeploy) predeploy ;;
    deploy) deploy ;;
    deploy-ingress) deploy_ingress ;;
    backup) encrypted_backup ;;
    verify-restore) verify_restore "${2:-}" ;;
    setup-triage) gmail_triage_setup ;;
    setup-hermes-auth) hermes_oauth_setup "${2:---main}" ;;
    gmail-status) gmail status ;;
    gmail-scan) gmail scan ;;
    gmail-propose-archive)
        gmail propose-archive "${2:-}" "${3:-}" "${4:-}"
        ;;
    gmail-reconcile-operation)
        gmail reconcile-operation "${2:-}" "${3:-}"
        ;;
    gmail-triage-status) gmail_triage_control status ;;
    gmail-triage-pause) gmail_triage_control pause ;;
    gmail-triage-run) gmail_triage_control run ;;
    gmail-triage-resume) gmail_triage_control resume ;;
    soak-start) soak start ;;
    soak-status) soak status ;;
    soak-complete) soak complete ;;
    status) status ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
